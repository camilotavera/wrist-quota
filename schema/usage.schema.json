{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-usage.local/schema/usage.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["accounts"],
  "properties": {
    "accounts": {
      "type": "array",
      "items": { "$ref": "#/$defs/account" }
    }
  },
  "$defs": {
    "limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "usedPercent", "resetLabel"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "usedPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "resetLabel": { "type": "string", "minLength": 1 }
      }
    },
    "headline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "usedPercent", "resetLabel"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "usedPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "resetLabel": { "type": "string", "minLength": 1 }
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "provider", "status", "updatedAt", "headline", "limits"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "provider": { "enum": ["codex", "claude"] },
        "status": { "enum": ["ready", "unavailable"] },
        "updatedAt": { "type": ["integer", "null"], "minimum": 0 },
        "headline": { "anyOf": [{ "$ref": "#/$defs/headline" }, { "type": "null" }] },
        "limits": { "type": "array", "items": { "$ref": "#/$defs/limit" } }
      },
      "oneOf": [
        {
          "properties": {
            "updatedAt": { "type": "integer" },
            "headline": { "$ref": "#/$defs/headline" },
            "limits": { "type": "array", "minItems": 1 }
          }
        },
        {
          "properties": {
            "status": { "const": "unavailable" },
            "updatedAt": { "type": "null" },
            "headline": { "type": "null" },
            "limits": { "type": "array", "maxItems": 0 }
          }
        }
      ]
    }
  }
}
